# Only needed for the timeline's plaque-reading and translate features.
# Everything else in the app works without it.
#
# Create a key at https://console.anthropic.com/settings/keys, then add it to
# Vercel:  Project -> Settings -> Environment Variables -> ANTHROPIC_API_KEY
#
# Never commit the real key, and never put it in client-side code — the browser
# ships its JavaScript to anyone who loads the page.
ANTHROPIC_API_KEY=sk-ant-...
